# ---------------------------------------------------------------------------
# Environment configuration — ZynReach Admin (System B), Phase 1
#
# Copy this file to .env for local development. Never commit real
# values — .env* is already gitignored.
#
# Phase 1 requires exactly two real values below (DATABASE_URL,
# SESSION_SECRET). Everything else is future-phase and intentionally
# absent — no CMS/Pricing/Media/Integration credentials exist yet because
# those modules are not built yet (SRS Phase 1 boundary).
# ---------------------------------------------------------------------------

# MySQL connection string (Prisma) — mysql://USER:PASSWORD@HOST:PORT/DATABASE.
# Point this at a MySQL 8+/MariaDB instance (Hostinger-provided, a local
# install, PlanetScale, etc.); create the database first, then run
# `npx prisma migrate deploy` to apply the schema. Required now — the app
# cannot run without a real database.
DATABASE_URL=

# Random secret used to sign session cookies. Generate one with:
#   openssl rand -base64 32
# Required now.
SESSION_SECRET=

# Base URL this app is served from (used for absolute links in emails,
# etc., once those exist). Defaults to localhost in development.
#
# Deployment structure: zynreach-website owns the main domain
# (https://www.zynreach.com). This app (zynreach-admin, System B) is
# deployed on a subdomain of that same domain — https://admin.zynreach.com
# in production — never on a separate domain of its own.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Shared secret zynreach-website's server-side services present as a
# Bearer token when calling POST /api/admin/leads/ingest (SRS §29:
# "authenticated (session or service token)" — this is the service-token
# path, distinct from AdminUser session login). Generate with:
#   openssl rand -base64 32
# Required now to exercise the leads-ingestion endpoint; not required
# until zynreach-website is actually updated to call it (future
# integration work, not Phase 1 itself).
SERVICE_INGEST_TOKEN=

# Optional — overrides the seeded initial Super Administrator's email
# (prisma/seed.ts). Defaults to admin@zynreach.local if unset.
# SEED_SUPER_ADMIN_EMAIL=

# Hostinger SMTP — sends real invitation emails for the admin-creates-user
# flow (src/lib/email/send.ts), send-only (no IMAP/POP3 configured
# anywhere). SMTP_USER authenticates the connection; SMTP_FROM is the
# sender address shown to recipients (falls back to SMTP_USER if unset).
# SMTP_SECURE is optional — defaults to true for port 465's implicit TLS,
# false otherwise; only set it to override that default (e.g. STARTTLS on
# port 587). SMTP_PASSWORD is the mailbox's real password from Hostinger's
# email panel. Required for invitation emails to actually be delivered —
# without these, the invite link is still generated and shown in the
# Dashboard as a fallback, but no email is sent.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
# SMTP_SECURE=true
SMTP_USER=notifications@zynreach.com
SMTP_PASSWORD=
SMTP_FROM=notifications@zynreach.com

# Encrypts AdminUser.mfaSecret (TOTP secret) at rest before it's written
# to the database (src/lib/auth/mfa.ts). Must decode to exactly 32 bytes
# (AES-256-GCM). Generate one with:
#   openssl rand -base64 32
# Required now — without it, new MFA enrollment fails safely with a clear
# error rather than storing a secret unencrypted. Accounts enrolled before
# this key existed keep working unchanged (see mfa.ts's decrypt function).
MFA_SECRET_ENCRYPTION_KEY=

# TEMPORARY LOCAL DEV CONVENIENCE — skips the MFA step on login so an
# MFA-required account (Super Administrator/Publisher) can be tested with
# just email + password. Only takes effect when NODE_ENV is NOT
# "production" (see src/lib/auth/dev-mfa-bypass.ts); still does nothing
# unless explicitly set to "true". Leave unset/false to keep MFA on,
# matching SRS §30. Never set this in a deployed environment.
# DEV_DISABLE_MFA=true

